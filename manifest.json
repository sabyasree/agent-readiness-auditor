{
  "manifest_version": 3,
  "name": "Agent-Readiness Auditor – AI Agent Website Checker",
  "short_name": "Agent Audit",
  "version": "1.3.0",
  "description": "Can AI agents use your website? Score any page for Claude, Gemini & ChatGPT agents, see what they see, and get fixes.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Agent-Readiness Auditor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open the auditor"
    }
  },
  "homepage_url": "https://agent-readiness-auditor.netlify.app/"
}
